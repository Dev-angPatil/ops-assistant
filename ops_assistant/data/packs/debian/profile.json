{
  "family_id": "debian",
  "display_name": "Debian / Ubuntu Family",
  "identification": {
    "os_release_ids": [
      "debian",
      "ubuntu",
      "linuxmint",
      "pop",
      "kali",
      "raspbian",
      "elementary",
      "zorin",
      "boss",
      "bossos"
    ],
    "os_release_id_like": [
      "debian",
      "ubuntu",
      "boss"
    ],
    "detection_file": "/etc/debian_version"
  },
  "init_system": "systemd",
  "default_firewall": "ufw",
  "security_subsystem": "apparmor",
  "log_paths": {
    "system": "/var/log/syslog",
    "auth": "/var/log/auth.log",
    "package_manager": "/var/log/dpkg.log",
    "kernel": "/var/log/kern.log",
    "audit": "/var/log/audit/audit.log"
  },
  "network_config_paths": [
    "/etc/netplan/",
    "/etc/network/interfaces",
    "/etc/network/interfaces.d/"
  ]
}